@{
    ViewData["Title"] = "HR Dashboard";
}

<h2>HR Dashboard</h2>

@if (ViewBag.UserName != null)
{
    <p>Welcome, <strong>@ViewBag.UserName</strong>!</p>
    <p>Total Lecturers: <strong>@ViewBag.TotalLecturers</strong></p>
    <p>Pending Claims: <strong>@ViewBag.PendingClaims</strong></p>

    <div class="mt-4">
        <a class="btn btn-primary" href="/HR/LecturerManagement">Lecturer Management</a>
        <a class="btn btn-secondary" href="/HR/ClaimApprovals">Review Claims</a>
    </div>
}
else
{
    <p>Session not found. Please login.</p>
}
