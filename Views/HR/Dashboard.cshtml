@{
    ViewData["Title"] = "HR Dashboard";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">HR Dashboard</h2>
        <span class="badge bg-success fs-6">Welcome, @ViewBag.UserName</span>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @ViewBag.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h6>Total Lecturers</h6>
                    <h3>@ViewBag.Stats.TotalLecturers</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h6>Total Claims</h6>
                    <h3>@ViewBag.Stats.TotalClaims</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-warning text-white">
                <div class="card-body text-center">
                    <h6>Pending Claims</h6>
                    <h3>@ViewBag.Stats.PendingClaims</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h6>Total Payments</h6>
                    <h3>R @ViewBag.Stats.TotalPayments.ToString("F2")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="@Url.Action("CreateLecturer", "HR")" class="btn btn-primary">
                            <i class="fas fa-user-plus me-2"></i>Add Lecturer
                        </a>
                        <a href="@Url.Action("ManageLecturers", "HR")" class="btn btn-success">
                            <i class="fas fa-users me-2"></i>Manage Lecturers
                        </a>
                        <a href="@Url.Action("ViewClaims", "HR")" class="btn btn-info">
                            <i class="fas fa-file-invoice me-2"></i>View Claims
                        </a>
                        <a href="@Url.Action("Reports", "HR")" class="btn btn-warning">
                            <i class="fas fa-chart-bar me-2"></i>Reports
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Claims -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Recent Claims</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentClaims != null && ViewBag.RecentClaims.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Lecturer</th>
                                        <th>Month</th>
                                        <th>Hours</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in ViewBag.RecentClaims)
                                    {
                                        <tr>
                                            <td>@claim.Contractor?.FullName</td>
                                            <td>@claim.Month</td>
                                            <td>@claim.HoursWorked</td>
                                            <td>R @claim.TotalAmount.ToString("F2")</td>
                                            <td>
                                                <span class="badge bg-@(claim.Status == "Approved" ? "success" : claim.Status == "Rejected" ? "danger" : "warning")">
                                                    @claim.Status
                                                </span>
                                            </td>
                                            <td>@claim.ClaimDate.ToString("MMM dd, yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No recent claims</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>