@{
    ViewData["Title"] = "Manage Lecturers";
    var lecturers = ViewBag.Lecturers as List<ProgPOEP1.Models.Lecturer>;
    var message = ViewBag.Message as string;
}

<h2 class="mb-4">Manage Lecturers</h2>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<a class="btn btn-outline-primary mb-3" asp-action="PaymentReportPdf">Download PDF Report</a>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>LecturerID</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Hourly Rate</th>
            <th>Username</th>
            <th>Approved</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lecturer in lecturers)
        {
            <tr>
                <td>@lecturer.LecturerID</td>
                <td>@lecturer.FullName</td>
                <td>@lecturer.Email</td>
                <td>@lecturer.Department</td>

                <td>
                    <form asp-action="AddOrUpdateLecturer" method="post" class="d-flex">
                        <input type="hidden" name="lecturerId" value="@lecturer.LecturerID" />
                        <input type="hidden" name="fullName" value="@lecturer.FullName" />
                        <input type="hidden" name="email" value="@lecturer.Email" />
                        <input type="hidden" name="department" value="@lecturer.Department" />
                        <input type="hidden" name="username" value="@lecturer.Username" />
                        <input type="hidden" name="password" value="@lecturer.Password" />
                        <input name="hourlyRate" type="number" step="0.01" value="@lecturer.HourlyRate" class="form-control me-2" style="width: 100px;" />
                        <button type="submit" class="btn btn-sm btn-primary">Update</button>
                    </form>
                </td>

                <td>@lecturer.Username</td>
                <td>
                    @if (!lecturer.IsApproved)
                    {
                        <form asp-action="ApproveLecturer" method="post">
                            <input type="hidden" name="lecturerId" value="@lecturer.LecturerID" />
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-success">Approved</span>
                    }
                </td>
                <td>
                    <form asp-action="DeleteLecturer" method="post" onsubmit="return confirm('Are you sure you want to delete this lecturer?');">
                        <input type="hidden" name="lecturerId" value="@lecturer.LecturerID" />
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
