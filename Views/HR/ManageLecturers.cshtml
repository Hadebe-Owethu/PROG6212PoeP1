@{
    ViewData["Title"] = "Manage Lecturers";
    var lecturers = ViewBag.Lecturers as List<ProgPOEP1.Models.Lecturer>;
    var message = ViewBag.Message as string;
}

<h2 class="mb-3">Manage Lecturers</h2>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<!-- Add or Update Lecturer Form -->
<form asp-action="AddOrUpdateLecturer" method="post" class="mb-4">
    <div class="row mb-2">
        <div class="col">
            <input type="text" name="lecturerId" class="form-control" placeholder="Lecturer ID" required />
        </div>
        <div class="col">
            <input type="text" name="fullName" class="form-control" placeholder="Full Name" required />
        </div>
        <div class="col">
            <input type="email" name="email" class="form-control" placeholder="Email" required />
        </div>
    </div>
    <div class="row mb-2">
        <div class="col">
            <input type="text" name="department" class="form-control" placeholder="Department" required />
        </div>
        <div class="col">
            <input type="number" step="0.01" name="hourlyRate" class="form-control" placeholder="Hourly Rate" required />
        </div>
        <div class="col">
            <input type="text" name="username" class="form-control" placeholder="Username" required />
        </div>
        <div class="col">
            <input type="password" name="password" class="form-control" placeholder="Password" required />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Add / Update Lecturer</button>
</form>

<!-- Lecturer List -->
@if (lecturers != null && lecturers.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Rate</th>
                <th>Approved</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in lecturers)
            {
                <tr>
                    <td>@l.LecturerID</td>
                    <td>@l.FullName</td>
                    <td>@l.Email</td>
                    <td>@l.Department</td>
                    <td>@l.HourlyRate.ToString("C")</td>
                    <td>@(l.IsApproved ? "Yes" : "No")</td>
                    <td>
                        <form asp-action="ApproveLecturer" method="post" class="d-inline">
                            <input type="hidden" name="lecturerId" value="@l.LecturerID" />
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                        </form>
                        <form asp-action="DeleteLecturer" method="post" class="d-inline">
                            <input type="hidden" name="lecturerId" value="@l.LecturerID" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No lecturers found.</p>
}
