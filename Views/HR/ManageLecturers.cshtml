@{
    ViewData["Title"] = "Manage Lecturers";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Manage Lecturers</h2>
        <a href="@Url.Action("CreateLecturer", "HR")" class="btn btn-primary">
            <i class="fas fa-user-plus me-2"></i>Add New Lecturer
        </a>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @ViewBag.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Lecturer List</h5>
        </div>
        <div class="card-body">
            @if (ViewBag.Lecturers != null && ViewBag.Lecturers.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Hourly Rate</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lecturer in ViewBag.Lecturers)
                            {
                                <tr>
                                    <td>@lecturer.FullName</td>
                                    <td>@lecturer.Username</td>
                                    <td>@lecturer.Email</td>
                                    <td>R @lecturer.HourlyRate.ToString("F2")</td>
                                    <td>
                                        <span class="badge bg-@(lecturer.IsApproved ? "success" : "warning")">
                                            @(lecturer.IsApproved ? "Approved" : "Pending")
                                        </span>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("EditLecturer", "HR", new { id = lecturer.LecturerID })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger delete-lecturer"
                                                data-id="@lecturer.LecturerID" data-name="@lecturer.FullName">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <h5>No Lecturers Found</h5>
                    <p class="text-muted">Get started by adding your first lecturer.</p>
                    <a href="@Url.Action("CreateLecturer", "HR")" class="btn btn-primary">Add Lecturer</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.delete-lecturer').click(function() {
                const id = $(this).data('id');
                const name = $(this).data('name');

                if (confirm(`Are you sure you want to delete ${name}?`)) {
                    $.post('@Url.Action("DeleteLecturer", "HR")', { id: id })
                        .done(function(response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert('Error: ' + response.message);
                            }
                        })
                        .fail(function() {
                            alert('Error deleting lecturer');
                        });
                }
            });
        });
    </script>
}