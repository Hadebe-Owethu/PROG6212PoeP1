@{
    ViewData["Title"] = "Review Claims";
    var pendingClaims = ViewBag.PendingClaims as List<ProgPOEP1.Models.Claim>;
}

<h2 class="mb-4">Pending Claims Overview</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info">@ViewBag.Message</div>
}

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Claim ID</th>
            <th>Contractor ID</th>
            <th>Month</th>
            <th>Hours</th>
            <th>Rate</th>
            <th>Total</th>
            <th>Document</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var claim in pendingClaims)
        {
            <tr>
                <td>@claim.ClaimID</td>
                <td>@claim.ContractorID</td>
                <td>@claim.Month</td>
                <td>@claim.HoursWorked</td>
                <td>@claim.HourlyRate</td>
                <td>@claim.TotalAmount</td>
                <td>
                    @if (!string.IsNullOrEmpty(claim.DocumentPath))
                    {
                        <a href="@claim.DocumentPath" target="_blank">View</a>
                    }
                    else
                    {
                        <span class="text-muted">No document</span>
                    }
                </td>
                <td>
                    <span class="badge @(claim.Status == "Pending" ? "bg-warning text-dark" :
                                                                   claim.Status == "Verified" ? "bg-primary" :
                                                                   claim.Status == "Approved" ? "bg-success" :
                                                                   claim.Status == "Rejected" ? "bg-danger" : "bg-secondary")">
                    @claim.Status
                </span>
            </td>
        </tr>
                }
    </tbody>
</table>
