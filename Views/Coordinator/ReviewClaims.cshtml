@{
    ViewData["Title"] = "Admin Dashboard";
    var claims = ViewBag.Claims as List<ProgPOEP1.Models.Claim>;
    var statusFilter = ViewBag.StatusFilter as string;
    var message = TempData["Message"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Claims Administration</h2>
    <form method="get" asp-action="AdminDashboard" class="d-flex align-items-center gap-2">
        <label for="statusFilter" class="form-label mb-0">Filter:</label>
        <select id="statusFilter" name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="Pending" selected="@(statusFilter == "Pending")">Pending</option>
            <option value="Verified" selected="@(statusFilter == "Verified")">Verified</option>
            <option value="Approved" selected="@(statusFilter == "Approved")">Approved</option>
            <option value="Rejected" selected="@(statusFilter == "Rejected")">Rejected</option>
        </select>
    </form>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success">@message</div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Claim ID</th>
            <th>Lecturer</th>
            <th>Month</th>
            <th>Hours</th>
            <th>Rate</th>
            <th>Total</th>
            <th>Status</th>
            <th>Verified</th>
            <th>Approved</th>
            <th>Rejected</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in claims)
        {
            <tr>
                <td>@c.ClaimID</td>
                <td>
                    @{
                        // If you do not have navigation properties, you can display ContractorID
                        // Or fetch lecturer name via a dictionary cached in ViewBag if you prefer
                    }
                    @c.ContractorID
                </td>
                <td>@c.Month</td>
                <td>@c.HoursWorked</td>
                <td>@c.HourlyRate.ToString("C")</td>
                <td>@(c.HoursWorked* c.HourlyRate).ToString("C")</td>
                <td>
                    <span class="badge @(c.Status == "Pending" ? "bg-warning text-dark"
                                                                         : c.Status == "Approved" ? "bg-success"
                                                                         : c.Status == "Rejected" ? "bg-danger"
                                                                         : c.Status == "Verified" ? "bg-info text-dark"
                                                                         : "bg-secondary")">@c.Status</span>
            </td>
            <td>@c.VerifiedAt?.ToString("g")</td>
            <td>@c.ApprovedAt?.ToString("g")</td>
            <td>@c.RejectedAt?.ToString("g")</td>
            <td>
                <form asp-action="UpdateClaimStatus" method="post" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="claimId" value="@c.ClaimID" />
                    <select name="newStatus" class="form-select form-select-sm">
                        <option value="Pending" selected="@(c.Status == "Pending")">Pending</option>
                        <option value="Verified" selected="@(c.Status == "Verified")">Verified</option>
                        <option value="Approved" selected="@(c.Status == "Approved")">Approved</option>
                        <option value="Rejected" selected="@(c.Status == "Rejected")">Rejected</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-primary">Update</button>
                </form>
            </td>
        </tr>
                }
    </tbody>
</table>
