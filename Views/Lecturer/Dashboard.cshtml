@{
    ViewData["Title"] = "My Claims";
    var claims = ViewBag.Claims as List<ProgPOEP1.Models.Claim>;
    var message = ViewBag.Message as string;
}

<h2 class="mb-4">My Submitted Claims</h2>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Month</th>
            <th>Hours Worked</th>
            <th>Hourly Rate</th>
            <th>Total Amount</th>
            <th>Status</th>
            <th>Verified At</th>
            <th>Approved At</th>
            <th>Rejected At</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var claim in claims)
        {
            <tr>
                <td>@claim.Month</td>
                <td>@claim.HoursWorked</td>
                <td>@claim.HourlyRate.ToString("C")</td>
                <td>@claim.TotalAmount.ToString("C")</td>
                <td>
                    <span class="badge @(claim.Status == "Pending" ? "bg-warning text-dark"
                                                  : claim.Status == "Approved" ? "bg-success"
                                                  : claim.Status == "Rejected" ? "bg-danger"
                                                  : claim.Status == "Verified" ? "bg-info text-dark"
                                                  : "bg-secondary")">@claim.Status</span>
            </td>
            <td>@claim.VerifiedAt?.ToString("g")</td>
            <td>@claim.ApprovedAt?.ToString("g")</td>
            <td>@claim.RejectedAt?.ToString("g")</td>
        </tr>
                }
    </tbody>
</table>
