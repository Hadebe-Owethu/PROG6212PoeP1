@{
    ViewData["Title"] = "Submit Claim";
    var hourlyRate = ViewBag.HourlyRate;
    var fullName = ViewBag.FullName as string;
    var message = ViewBag.Message as string;
}

<h2 class="mb-3">Submit Claim</h2>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-danger">@message</div>
}

<form method="post" asp-action="SubmitClaim" enctype="multipart/form-data">
    <div class="mb-3">
        <label>Lecturer</label>
        <input type="text" class="form-control" value="@fullName" readonly />
    </div>

    <div class="mb-3">
        <label>Hourly Rate</label>
        <input type="text" class="form-control" value="@hourlyRate" readonly />
    </div>

    <div class="mb-3">
        <label>Month</label>
        <input type="text" name="month" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Hours Worked</label>
        <input type="number" name="hours" class="form-control" min="1" max="180" required />
    </div>

    <div class="mb-3">
        <label>Notes</label>
        <textarea name="notes" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Supporting Document (.pdf, .docx, .xlsx)</label>
        <input type="file" name="document" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Submit Claim</button>
</form>
