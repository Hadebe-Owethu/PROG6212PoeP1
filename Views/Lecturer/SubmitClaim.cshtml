@{
    ViewData["Title"] = "Submit Claim";
    var message = ViewBag.Message as string;
    var rate = ViewBag.HourlyRate as decimal?;
    var fullName = ViewBag.FullName as string;
}

<h2 class="mb-4">Submit Monthly Claim</h2>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info" role="alert">@message</div>
}

<form method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label class="form-label">Lecturer</label>
        <input type="text" class="form-control" value="@fullName" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Hourly Rate</label>
        <input type="number" class="form-control" id="HourlyRate" value="@rate" readonly />
    </div>

    <div class="mb-3">
        <label for="month" class="form-label">Month</label>
        <input type="text" class="form-control" id="month" name="month" placeholder="e.g., September" required />
    </div>

    <div class="mb-3">
        <label for="hours" class="form-label">Hours Worked</label>
        <input type="number" class="form-control" id="HoursWorked" name="hours" required />
        <small class="text-muted">Maximum 180 hours per month</small>
    </div>

    <div class="mb-3">
        <label class="form-label">Total Amount</label>
        <input type="number" class="form-control" id="TotalAmount" readonly />
    </div>

    <div class="mb-3">
        <label for="notes" class="form-label">Additional Notes</label>
        <textarea class="form-control" id="notes" name="notes" rows="3" placeholder="Optional notes..."></textarea>
    </div>

    <div class="mb-3">
        <label for="document" class="form-label">Upload Supporting Document</label>
        <input type="file" class="form-control" id="document" name="document" accept=".pdf,.docx,.xlsx" />
    </div>

    <button type="submit" class="btn btn-lg btn-success w-100">Submit Claim</button>
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        function recalc() {
            const h = parseFloat($('#HoursWorked').val()) || 0;
            const r = parseFloat($('#HourlyRate').val()) || 0;
            $('#TotalAmount').val((h * r).toFixed(2));
        }
        $('#HoursWorked').on('input', recalc);
        recalc();
    </script>
}
