@{
    ViewData["Title"] = "Academic Manager Dashboard";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Academic Manager Dashboard</h2>
        <span class="badge bg-success fs-6">Welcome, @ViewBag.UserName</span>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @ViewBag.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h6>Verified Claims</h6>
                    <h3>@ViewBag.Stats.TotalVerified</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h6>Approved Claims</h6>
                    <h3>@ViewBag.Stats.TotalApproved</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h6>Monthly Total</h6>
                    <h4>R @ViewBag.Stats.MonthlyTotal.ToString("F2")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-warning text-white">
                <div class="card-body text-center">
                    <h6>Yearly Total</h6>
                    <h4>R @ViewBag.Stats.YearlyTotal.ToString("F2")</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Verified Claims for Final Approval -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">Verified Claims for Final Approval</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.VerifiedClaims != null && ViewBag.VerifiedClaims.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Lecturer</th>
                                        <th>Month</th>
                                        <th>Hours</th>
                                        <th>Amount</th>
                                        <th>Date Verified</th>
                                        <th>Verified By</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in ViewBag.VerifiedClaims)
                                    {
                                        <tr>
                                            <td>@claim.Lecturer?.FullName</td>
                                            <td>@claim.Month</td>
                                            <td>@claim.HoursWorked</td>
                                            <td>R @claim.TotalAmount.ToString("F2")</td>
                                            <td>@(claim.VerifiedAt?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                            <td>@claim.VerifiedBy</td>
                                            <td>
                                                <button class="btn btn-sm btn-success approve-claim"
                                                        data-id="@claim.ClaimID">
                                                    <i class="fas fa-check me-1"></i>Approve
                                                </button>
                                                <button class="btn btn-sm btn-danger reject-claim"
                                                        data-id="@claim.ClaimID" data-name="@claim.Lecturer?.FullName">
                                                    <i class="fas fa-times me-1"></i>Reject
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No verified claims for final approval</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Approved Claims -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">Approved Claims</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.ApprovedClaims != null && ViewBag.ApprovedClaims.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Lecturer</th>
                                        <th>Month</th>
                                        <th>Hours</th>
                                        <th>Amount</th>
                                        <th>Date Approved</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in ViewBag.ApprovedClaims)
                                    {
                                        <tr>
                                            <td>@claim.Lecturer?.FullName</td>
                                            <td>@claim.Month</td>
                                            <td>@claim.HoursWorked</td>
                                            <td>R @claim.TotalAmount.ToString("F2")</td>
                                            <td>@(claim.ApprovedAt?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                            <td>
                                                <span class="badge bg-success">@claim.Status</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No approved claims</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.approve-claim').click(function() {
                const id = $(this).data('id');

                if (confirm('Are you sure you want to approve this claim for payment?')) {
                    $.post('@Url.Action("ApproveClaim", "Admin")', { claimId: id })
                        .done(function(response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert('Error: ' + response.message);
                            }
                        })
                        .fail(function() {
                            alert('Error approving claim');
                        });
                }
            });

            $('.reject-claim').click(function() {
                const id = $(this).data('id');
                const name = $(this).data('name');
                const reason = prompt('Please enter reason for rejection:');

                if (reason) {
                    $.post('@Url.Action("RejectClaim", "Admin")', {
                        claimId: id,
                        reason: reason
                    })
                    .done(function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    })
                    .fail(function() {
                        alert('Error rejecting claim');
                    });
                }
            });
        });
    </script>
}
