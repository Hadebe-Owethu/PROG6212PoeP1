@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <i class="fas fa-exclamation-triangle fa-5x text-warning mb-4"></i>
            <h1 class="text-danger">Oops! Something went wrong.</h1>
            <p class="lead">An error occurred while processing your request.</p>
            <p class="text-muted">Please try again later or contact support if the problem persists.</p>
            <a href="@Url.Action("Login", "Account")" class="btn btn-primary mt-3">
                <i class="fas fa-home me-2"></i>Return to Login
            </a>
        </div>
    </div>
</div>