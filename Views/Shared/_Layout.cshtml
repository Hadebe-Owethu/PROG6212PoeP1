<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CMCS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">CMCS</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Lecturer" asp-action="Dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Lecturer" asp-action="Signup">Sign Up</a>
                    <li class="nav-item"><a class="nav-link" asp-controller="HR" asp-action="ManageLecturers">Manage Lecturers</a>
                    <li class="nav-item"><a class="nav-link" asp-controller="Lecturer" asp-action="SubmitClaim">Submit Claim</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Coordinator" asp-action="ReviewClaims">Review Claims</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Summary">Admin Summary</a></li>   
                    </li>

                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
