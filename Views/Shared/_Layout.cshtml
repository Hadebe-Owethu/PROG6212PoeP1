@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("Role");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CMCS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Account" asp-action="Login">CMCS</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">

                    @* Lecturer Links *@
                    @if (role == "Lecturer")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Lecturer" asp-action="Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Lecturer" asp-action="SubmitClaim">Submit Claim</a>
                        </li>
                    }

                    @* Coordinator Links *@
                    @if (role == "Coordinator")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Coordinator" asp-action="AdminDashboard">Coordinator Dashboard</a>
                        </li>
                    }

                    @* Admin (Academic Manager) Links *@
                    @if (role == "AcademicManager")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="AdminDashboard">Admin Dashboard</a>
                        </li>
                    }

                    @* HR Links *@
                    @if (role == "HR")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="HR" asp-action="ManageLecturers">Manage Lecturers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="HR" asp-action="PaymentReportPdf">Reports (PDF)</a>
                        </li>
                    }

                    @* Logout for all roles *@
                    @if (!string.IsNullOrEmpty(role))
                    {
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button class="btn btn-outline-danger btn-sm">Logout</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
