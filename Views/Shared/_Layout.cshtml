<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMCS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .navbar-brand {
            font-weight: bold;
        }

        .sidebar {
            min-height: calc(100vh - 56px);
            background-color: #f8f9fa;
        }

            .sidebar .nav-link {
                color: #333;
                padding: 10px 15px;
                border-radius: 5px;
                margin: 2px 0;
            }

                .sidebar .nav-link:hover {
                    background-color: #e9ecef;
                }

                .sidebar .nav-link.active {
                    background-color: #007bff;
                    color: white;
                }

        .main-content {
            padding: 20px;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">
                <i class="fas fa-university me-2"></i>CMCS
            </a>
            <div class="navbar-nav ms-auto">
                @if (Context.Session.GetString("UserRole") != null)
                {
                    <span class="navbar-text me-3">
                        Welcome, @Context.Session.GetString("LecturerName")@Context.Session.GetString("HRName")@Context.Session.GetString("CoordinatorName")@Context.Session.GetString("AdminName")
                    </span>
                    <form method="post" action="@Url.Action("Logout", "Account")" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-sign-out-alt me-1"></i>Logout
                        </button>
                    </form>
                }
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            @if (Context.Session.GetString("UserRole") != null)
            {
                <div class="col-md-3 col-lg-2 sidebar">
                    <nav class="nav flex-column">
                        @{
                            var userRole = Context.Session.GetString("UserRole");
                        }

                        @if (userRole == "Lecturer")
                        {
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                               href="@Url.Action("Dashboard", "Lecturer")">
                                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                            </a>
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SubmitClaim" ? "active" : "")"
                               href="@Url.Action("SubmitClaim", "Lecturer")">
                                <i class="fas fa-plus-circle me-2"></i>Submit Claim
                            </a>
                        }
                        else if (userRole == "HR")
                        {
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                               href="@Url.Action("Dashboard", "HR")">
                                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                            </a>
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageLecturers" ? "active" : "")"
                               href="@Url.Action("ManageLecturers", "HR")">
                                <i class="fas fa-users me-2"></i>Manage Lecturers
                            </a>
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ViewClaims" ? "active" : "")"
                               href="@Url.Action("ViewClaims", "HR")">
                                <i class="fas fa-file-invoice me-2"></i>View Claims
                            </a>
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")"
                               href="@Url.Action("Reports", "HR")">
                                <i class="fas fa-chart-bar me-2"></i>Reports
                            </a>
                        }
                        else if (userRole == "Coordinator")
                        {
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AdminDashboard" ? "active" : "")"
                               href="@Url.Action("AdminDashboard", "Coordinator")">
                                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                            </a>
                        }
                        else if (userRole == "AcademicManager")
                        {
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AdminDashboard" ? "active" : "")"
                               href="@Url.Action("AdminDashboard", "Admin")">
                                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                            </a>
                        }
                    </nav>
                </div>
            }

            <div class="@(Context.Session.GetString("UserRole") != null ? "col-md-9 col-lg-10" : "col-12") main-content">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>